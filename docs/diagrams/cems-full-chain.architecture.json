  "cards": [
    {
      "dot": "emerald",
      "title": "主链路（已在运行）",
      "items": [
        "仿真每 2 秒把 9 个测点写进仪表数据区；网关每 5 秒读一轮并发布",
        "接入层收到后先校验（不合法整条拒收），再入库；入库成功才算数"
      ]
    },
    {
      "dot": "cyan",
      "title": "断网怎么办（数据不丢的设计）",
      "items": [
        "发不出去就先存本机磁盘；联网后由独立线程按时间顺序补齐，只删对方确认过的",
        "取批用唯一文件名原子换名，进程被强杀也不会丢批次"
      ]
    },
    {
      "dot": "rose",
      "title": "告警与报表",
      "items": [
        "超标判定是入库成功后的同步动作（在收报文的线程里做，出错不影响入库）",
        "整点结算才是独立线程，用自己的数据库连接，不跟收报文抢"
      ]
    },
    {
      "dot": "amber",
      "title": "北向出口：做好了，还没接进网关",
      "items": [
        "网关代码里没有任何出口引用；目前只有本地验证脚本在调它（这是有意留的待接线）",
        "三个出口共用同一套接口，但算送达的标准各不相同：等应答 / 看 HTTP 状态码 / 写成功即算",
        "验证脚本可从时序库取一条真实数据当样例（为保持图面整洁，未画该连线）"
      ]
    },
    {
      "dot": "cyan",
      "title": "落地（现场部署）要改什么",
      "items": [
        "移出去：设备仿真、模拟寄存器、本地回环验证脚本（都是模拟的、开发期的）",
        "跟着现场走：网关 + 续传缓存 + 补传（放现场工控机；断网时现场必须能继续采集并暂存）",
        "可以放机房：EMQX / 接入层 / 时序库 / 大屏 / Redis",
        "唯一对外的仍应是 nginx；其余保持不对外（把 127.0.0.1 默认绑定按需改成内网地址，而不是把服务搬走）"
      ]
    }
  ]
