# 密钥/本地配置（只提交 .env.example，不提交 .env）
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 运行时产物：data/ 下全是跑起来才生成的东西（断网缓存、可写自检探针等），
# 一律不入库，只留一个占位文件保住目录
data/*
!data/.gitkeep

# 运行时日志一律不入库（容器 stderr、逐行确认之类的体量最大、信息量最低）
*.log

# 编辑器
.idea/
.vscode/

# archify 图的工作目录（中间产物；定稿的图与源规格在 docs/diagrams/）
.archify/

# archify 行号重映射的中间产物（一次性）
.refmap.tmp

# ============================================================================
# 过程产物：不入库（本地留档在仓库外的 _local/）
# 判据见 CONTRIBUTING.md §七「什么该进仓库」：
#   只放"别人拿这个仓库能复现/复核结论"所需要的东西；
#   "我是怎么做出来的"（过程记录、工具回执、自动生成的报告）一律留在本地。
# ============================================================================

# 工具/环境的过程记录
docs/evidence/drill/code_identity_*.txt

# 自动生成的运行报告
data/*.txt
*_report_*.txt
morning_report*.txt

