# CEMS 项目环境变量示例
#
# 用法：复制成 .env 后按需修改。docker-compose.yml 会自动读取 .env。
#      cp .env.example .env
#
# 说明：下面这些默认值是「本机演示」用的，不是真实口令。
#      对外部署时务必改成自己的口令，并且不要把 .env 提交到 git（已在 .gitignore 中忽略）。

# ---- TDengine 账号（平台接入层 subscriber 和展示层 web 都用）----
TD_USER=root
TD_PASS=taosdata

# ---- 库表名（改这里要全链路同步）----
TD_DB=cems
TD_STABLE=cems_data
TD_PLANT=plant1
TD_DEVICE=device1

# ---- MQTT ----
MQTT_TOPIC=cems/plant1/data
MQTT_QOS=1

# ---- 网关：发送确认与断网补传（一般不用改）----
# PUBACK 是 broker 对 QoS=1 消息的确认。只有收到 PUBACK 才算送达，
# 超时未确认的数据会转存到 data/cache.jsonl 等下次补传，不会静默丢弃。
PUBLISH_ACK_TIMEOUT=5.0
RESEND_WINDOW=100
RESEND_RETRY_INTERVAL=30.0

# ---- Web 大屏 ----
WEB_PORT=5000
QUERY_MINUTES=10
REFRESH_SECONDS=5
