# CEMS 项目环境变量示例
#
# 用法：复制成 .env 后按需修改。docker-compose.yml 会自动读取 .env。
#      cp .env.example .env
#
# 说明：下面这些默认值是「本机演示」用的，不是真实口令。
#      对外部署时务必改成自己的口令，并且不要把 .env 提交到 git（已在 .gitignore 中忽略）。

# ---- TDengine 账号（平台接入层 subscriber 和展示层 web 都用）----
# 这两个是「本机演示」默认口令。端口默认只绑 127.0.0.1，
# 一旦把 BIND_ADDR 改成 0.0.0.0（局域网可访问），必须先把口令改掉。
TD_USER=root
TD_PASS=taosdata

# ---- 端口绑定地址 ----
# 127.0.0.1（默认）：只有本机能访问，最安全
# 0.0.0.0：局域网可访问，但 EMQX/TDengine/管理台会一起暴露，需先改口令
BIND_ADDR=127.0.0.1

# ---- 库表名（改这里要全链路同步）----
TD_DB=cems
TD_STABLE=cems_data
TD_PLANT=plant1
TD_DEVICE=device1

# ---- MQTT ----
MQTT_TOPIC=cems/plant1/data
MQTT_QOS=1

# 订阅端会话持久化：0 = 持久会话（推荐），1 = 干净会话
# 持久会话下，订阅端离线期间 broker 会为 QoS≥1 的消息排队，重连后自动补投；
# 干净会话则不留任何状态，离线期间的报文会被 broker 直接丢弃。
# 注意：持久会话靠固定的 client_id 识别，别把 MQTT_CLIENT_ID 改成随机值。
MQTT_CLEAN_SESSION=0
MQTT_CLIENT_ID=cems-subscriber-plant1

# ---- 网关：发送确认与断网补传（一般不用改）----
# PUBACK 是 broker 对 QoS=1 消息的确认。只有收到 PUBACK 才算送达，
# 超时未确认的数据会转存到 data/cache.jsonl 等下次补传，不会静默丢弃。
PUBLISH_ACK_TIMEOUT=5.0
RESEND_WINDOW=100
RESEND_RETRY_INTERVAL=30.0

# 断网缓存容量上限（字节）。长期断网时缓存会一直涨，写满磁盘后每条都会丢；
# 超过上限就丢最旧的、保最新的，并打 CRITICAL 日志。默认 64MB。
CACHE_MAX_BYTES=67108864

# ---- 设备层：仿真信号（可复现）----
# 设备读数由 src/device/simulator.py 生成：基线 + 日周期 + 缓慢漂移 + 小毛刺，
# 不再是每个周期在量程内独立随机。三个参数决定"能不能复现"：
SIM_SEED=20261001
# 随机种子：同种子 + 同时间参数 => 逐值一致的输出。
#   ⚠️ 不设也有确定性默认值（20261001），不会每次跑出不同曲线；
#      故障演练建议显式写死一个种子。
# SIM_EPOCH=2026-01-01T00:00:00+00:00
# 漂移/负荷波形的时间基准（ISO 8601，必须带时区偏移）。改它只整体平移漂移波形。
# SIM_CLOCK_SKEW=0
# 给设备仿真时钟加的固定偏移（秒），例如 43200 = 让设备认为现在是 12 小时之后，
# 用来演练"设备时钟错位"类故障。默认 0 = 用真实时钟。

# 污染物偶发尖峰（只作用于 Dust/SO2/NOx）：让"超标"成为**事件**而不是常态或永不发生。
# SIM_SPIKE_PROB = 每个刷新周期（2 秒）触发一个尖峰的独立概率。
#   ⚠️ 别按"每小时几次"直觉取值：一个采样落在尖峰窗口内的概率 ≈ 1-(1-p)^(2×宽度步数)。
#   p=0.004（默认）⇒ 窗口命中率约 1/3、折算值越限时间占比约 5%（偶发但每天都能看到）。
#   设 0 = 关闭尖峰，此时污染物恒定达标（用来复核基线标定）。
SIM_SPIKE_PROB=0.004
# SIM_SPIKE_ENABLE=0 可整体关闭尖峰（等价于 SIM_SPIKE_PROB=0，但更直观）
# SIM_SPIKE_AMPLITUDE_LOW / HIGH：尖峰峰值区间，单位是**限值**（默认 0.30~0.55）
# SIM_SPIKE_WIDTH_STEPS：尖峰包络半宽，单位是刷新周期（默认 60 步 = ±2 分钟）

# ⚠️ 折算值是**导出量**：库里只存标干浓度和氧含量，不新建折算列。
#    下游判超标请现算 points.to_reference_o2(标干值, 实测O2)，口径是折算值不是标干值
#    （反例：标干 SO2=30 达标，但 O2=9% 时折算 37.5 超标）。

# ---- 排放超标告警（ADR-0002 方案乙：接入层逐条判折算值）----
# 判据实现在 src/common/alarm_judge.py；判定只在入库成功后追加一次调用，
# 不改接入层的拒收逻辑、不改测点契约、不加服务、不加依赖。
# 落库三张表（全部 CREATE ... IF NOT EXISTS，幂等建表）：
#   cems_alarm_event     事件行 + 判定快照（标干值/O2/基准氧/限值/折算值/judge_version）
#                        子表 = plant_device_point_judgetype，写同一 ts 覆盖 → QoS1 重投不多行
#   cems_hourly_verdict  小时结论（ok/over/insufficient）；样本不足**绝不判达标**
#   cems_alarm_push      推送记录（一期没有外部推送通道，"推送"落成这张表 + 结构化日志）
ALARM_ENABLE=1

# 触发出口径（§3.2 的 B：滑窗计数，不是严格连续、不是单点瞬时）：
# 最近 M 条**有效**样本里至少 N 条折算值越限 → 开一个超标事件。
# ⚠️ M/N 越小越容易触发：M=1 等价于"单点瞬时"（实测 NOx 一小时 62 条 → 告警风暴），不要那样配。
ALARM_WINDOW_SAMPLES=6
ALARM_MIN_OVER_SAMPLES=3

# 结束口径（§3.3）：连续 K 条折算值 ≤ 限值 × 恢复系数 才算恢复。
# 用 0.95 而不是 1.0 是为了**滞回**：贴限值波动时不会 begin/end 反复抖。
ALARM_RECOVER_RATIO=0.95
ALARM_RECOVER_SAMPLES=6
# 事件一直 OPEN 时的提醒间隔（秒）；0 = 不提醒（只在 start/end 通知）
ALARM_REMIND_SECONDS=1800

# 小时结算（§3.4）：读原始行 + 用契约函数 points.to_reference_o2() 重算折算值（折算不落库）。
ALARM_HOURLY_ENABLE=1
# 启动时补结算几个已闭合小时（进程重启/首次上线不用干等整点）
ALARM_HOURLY_BACKFILL_HOURS=2
# 整点后等多久再结算上一个小时：等网关补传收尾（补传实测最大滞后 32.1s，取 60s）
ALARM_SETTLE_DELAY_SECONDS=60

# 覆盖率门限（0~1）：有效样本/应有样本 < 它 → 判 **insufficient**，既不判达标也不判超标。
# 行业通行做法是"每小时至少 45 分钟有效数据"，本项目未取到一手条文，按可配置实现。
# ⚠️ 最危险的漏报形态是"缺数据被当成达标"，所以这一项宁可判不足，不要往低调。
ALARM_COVERAGE_MIN=0.75
# 无效样本占比上限：O2 >= 21% 时折算无物理意义（契约返回 nan），该小时占比超上限 → insufficient
ALARM_INVALID_RATIO_MAX=0.10

# 应有样本数的分母来源：应有条数 = 3600 / 该值（5.0 ⇒ 720 条/小时）。
# ⚠️ 必须与网关的 POLL_INTERVAL 一致（docker-compose 里 gateway 当前固定 5.0）。
ALARM_POLL_INTERVAL=5.0

# 判据版本号：写进每条事件快照。改判据口径/公式/限值时**必须改它**，历史结论才解释得清。
ALARM_JUDGE_VERSION=v1.0.0
# 推送渠道标识（写进推送记录）：
#   log     = 只落推送记录 + 结构化日志（默认，不需要任何外部服务）
#   webhook = ⭐ 真的 POST 告警 JSON 到 ALARM_PUSH_URL（设了 URL 才生效）
# 推送记录里的 status：recorded（只落记录）/ sent（Webhook 2xx）/ failed（Webhook 失败）
# ⚠️ failed 不影响事件落库 —— 通知是附加动作，不能拖累数据主链路。
ALARM_PUSH_CHANNEL=log
# Webhook 接收地址（channel=webhook 时必填；留空则自动降级为 recorded）
# 例：ALARM_PUSH_URL=http://127.0.0.1:9000/alarm
ALARM_PUSH_URL=
# Webhook 超时（秒）。设小一点：推送慢不能拖住入库。
ALARM_PUSH_TIMEOUT=3.0
# 判据统计日志周期（条）：每 N 条打一行 已判/重投跳过/事件/无效样本 计数（可观测性）
ALARM_STATS_LOG_SAMPLES=60
# 表名（一般不用改；改了要保证子表名不与 cems_data 的子表冲突）
ALARM_EVENT_STABLE=cems_alarm_event
ALARM_VERDICT_STABLE=cems_hourly_verdict
ALARM_PUSH_STABLE=cems_alarm_push

# ---- Web 大屏 ----
WEB_PORT=5000
QUERY_MINUTES=10
REFRESH_SECONDS=5
# 单次查询最多返回多少个点：防止"最近 N 分钟"在数据积压时把响应体撑爆
QUERY_LIMIT=5000

# ---- 反向代理（nginx）----
# 对外入口端口。默认 80：浏览器直接 http://localhost 即可，不用记端口。
# ⚠️ 80 是否可用取决于本机有没有别的 Web 服务占用（IIS / 其它站点）；
#    被占用时改这里，对外地址随之变成 http://localhost:<NGINX_HOST_PORT>。
NGINX_HOST_PORT=80

# ---- 报表覆盖率标记（缺数要标出来，不许消失）----
# 报表接口在每个时间窗上给出 coverage（覆盖率）与 insufficient（样本不足），
# 并在响应里给出汇总（窗口数 / 不足窗口数 / 整体覆盖率 / 缺口清单）。
# 口径与取值论证见 src/web/report.py 头部与 docs/告警判据设计.md §3.4。

# 采集周期（秒）：覆盖率的分母来源 —— 应有条数 = 窗口秒数 / 采集周期（5.0 ⇒ 每分钟 12 条）。
# ⚠️ 必须与网关的 POLL_INTERVAL 一致（docker-compose 里 gateway 当前固定 5.0）。
POLL_INTERVAL=5.0

# 覆盖率门限（0~1）：低于它判 insufficient，**绝不判达标**。
# 默认 0.75 与 docs/告警判据设计.md §3.4 的 ALARM_COVERAGE_MIN 同值。
# ⚠️ 不要往 1.0 调：实测真实采集周期 5.154 s（docs/性能与可靠性指标.md §2.1），
#    按名义 5.0 s 算的覆盖率天花板只有 5.0/5.154 = 97.0%；1 分钟窗口实际只拿到 11~12 条。
#    实测 683 个干净窗口的覆盖率 P05=91.7%、最差 83.3%（scripts/measure_report_coverage.py），
#    门限调到 0.84 以上就会开始把正常数据标成"样本不足"。
REPORT_COVERAGE_MIN=0.75

# 缺口清单条数上限：只截断清单本身，计数与判定仍按全部窗口给。
# 整段断档（例如 92 天自由报表）时清单会与窗口数同阶，设上限避免响应体翻倍。
REPORT_GAP_MAX=200

# 在途样本宽限（秒）：只作用于进行中的窗口（日报表当前这个小时、月报表今天这一天）。
# 网关补传慢路径实测最大滞后 32.1 s（docs/性能与可靠性指标.md §4.2），取 60 s = 1.9 倍余量；
# 不设宽限会在每个小时的头几十秒把"样本还在路上"误判成"样本不足"。
# 取 0 = 不做宽限（只建议在离线回放/对照实验里用）。
REPORT_INFLIGHT_GRACE_SECONDS=60

# ---- 展示层查询缓存（Redis）----
# 缓存只作用于"已闭合时间窗"的聚合查询；正确性边界见 src/web/cache.py 顶部。
# 0 = 关闭缓存（行为完全回到"每次都查库"），用于前后对照测量；
# 1 = 开启（默认）。Redis 服务端不可用时本项无意义——缓存会自己整层降级为直连查库。
CACHE_ENABLED=1

# 安全边界（秒）：查询上界必须早于"最近观测到的库内数据时间戳"这么多秒才允许进缓存。
# 取值依据 = 网关补传慢路径实测最大滞后 32.1 s（docs/性能与可靠性指标.md §4.2）。
# 调小它会让迟到的补传行落进"已闭合"窗口；调大只是让缓存利用率下降。
CACHE_MARGIN_SECONDS=60

# 缓存条目 TTL（秒）：兜底失效，覆盖"水位丢失 / 外部直接改库 / 超长滞后补传"三种情况。
CACHE_TTL_SECONDS=300
